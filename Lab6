namespace Lab8
{
    class Animal
    {
        public string Name { get; set; }
        public int Age { get; set; }

        

        public Animal(string name, int age)
        {
            Name = name;
            Age = age;
            Console.WriteLine("Animal Constructor");
        }
        
            


        public virtual void Info()
        {

        }

        public void Eat()
        {
            Console.WriteLine($"{Name} is eating.");
        }

        public virtual void MakeSound()
        {
            Console.WriteLine("Some Sound");
        }


    }

    class Dog : Animal 
    {
        public string Breed { get; set; }

        public Dog(string name,int age ,string breed) : base (name, age)
        {
            Breed = breed;
            Console.WriteLine("Dog Constructor");
        }

        public override void Info()
        {
            Console.WriteLine($"Name: {Name}  Age: {Age}  Race: {Breed}");
        }

        public void Fetch()
        {
            Console.WriteLine($"{Name} brings the ball back.");
        }

        public override void MakeSound()
        {
            Console.WriteLine($"{Name}: Woof Woof!");
        }


    }

    class Cat : Animal
    {
        public string Breed { get; set; }

        public Cat(string name, int age, string breed) : base(name, age)
        {
            Breed = breed;
            Console.WriteLine("Cat Constructor");
        }

        public override void Info()
        {
            Console.WriteLine($"Name: {Name}  Age: {Age}  Race: {Breed}");
        }

        public void Fetch()
        {
            Console.WriteLine($"{Name} brings the ball back.");
        }

        public override void MakeSound()
        {
            Console.WriteLine($"{Name}: Meow Meow!");
        }


    }




    internal class Program
    {
        static void Main(string[] args)
        {
            Animal[] animals = new Animal[2];

            animals[0] = new Dog("Karabas", 2, "Kangal");
            animals[1] = new Cat("Pamuk", 3, "British");

            


            foreach (var animal in animals) {
                animal.Info();
                animal.Eat();
                animal.MakeSound();
            }

            

        }
    }
}
